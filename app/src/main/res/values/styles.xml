<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.AppTheme.LikeCheckBox"
        parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="iconTint">@color/colorPrimary</item>


    </style>

    <style name="Widget.MaterialComponents.CompoundButton.CheckBox"
        parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="enforceMaterialTheme">true</item>
        <item name="useMaterialThemeColors">true</item>
        <item name="android:minWidth">?attr/minTouchTargetSize</item>
        <item name="android:minHeight">?attr/minTouchTargetSize</item>
    </style>

    <style name="fabstyle" parent="Base.Theme.NeWork">
        <item name="android:backgroundTint">@color/colorAppBar</item>
        <item name="cornerSize">20%</item>
    </style>

    <style name="appBarstyle" parent="Base.Theme.NeWork">
        <item name="android:backgroundTint">@color/colorPrimaryContainer</item>
    </style>

    <style name="fabStyle" parent="Widget.Design.FloatingActionButton">
        <item name="shapeAppearanceOverlay">@style/fabShape</item>
    </style>
    
    
    
    <style name="fabShape" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">20%</item>

    </style>
    <style name="buttomRemove" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="color">@color/colorPrimary</item>

    </style>
</resources>